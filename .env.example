# Exemplo de variáveis de ambiente. Não versione valores reais.

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5435/iwrite
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MCP (desabilitado por padrão; /sse e /mcp/message não são expostos)
IWRITE_MCP_ENABLED=false

# OpenTelemetry (opcional; padrão desabilitado, sem nenhuma variável extra)
IWRITE_OTEL_ENABLED=false

# Exige OTEL_EXPORTER_OTLP_HEADERS quando true (backend institucional).
# Com false, dispensa headers (ex.: LGTM local sem autenticação).
# Seguro para o servidor institucional. O override local de observabilidade
# define false explicitamente para o LGTM sem autenticação.
IWRITE_OTEL_AUTH_REQUIRED=true

# Obrigatórias apenas quando IWRITE_OTEL_ENABLED=true.
#OTEL_SERVICE_NAME=dsc-eq22

# --- Ambiente local (LGTM via docker-compose.observability.yml) ---
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318

# --- Servidor institucional (IWRITE_OTEL_AUTH_REQUIRED=true) ---
# O token/headers devem vir de secret ou variável de ambiente ignorada pelo Git.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.exemplo-institucional.invalid
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <TOKEN_AQUI>

# Defaults aplicados automaticamente quando OTel está habilitado e a variável
# não é definida (não é preciso declarar, listado aqui só como referência):
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#OTEL_TRACES_EXPORTER=otlp
#OTEL_METRICS_EXPORTER=otlp
#OTEL_LOGS_EXPORTER=otlp

# --- Demonstração multi-tenant (#137) ---
# Só têm efeito com o profile `demo` ativo (docker-compose.demo.yml).
# Sem valor padrão de propósito: senha padrão em repositório é senha publicada.
# Gere valores fortes localmente e NUNCA versione os reais.
IWRITE_DEMO_SEED_ENABLED=false
IWRITE_DEMO_AUTOR_A_PASSWORD=
IWRITE_DEMO_AUTOR_B_PASSWORD=

# --- Provisionamento de credencial (rollout e desenvolvimento local) ---
# Define a senha de login de UM usuário já existente; nunca cria um usuário.
# Sem valor padrão de propósito. Rode uma vez e remova as três variáveis em
# seguida — a senha não deve permanecer no ambiente do processo.
IWRITE_CREDENTIAL_PROVISIONING_ENABLED=false
IWRITE_CREDENTIAL_PROVISIONING_EMAIL=
IWRITE_CREDENTIAL_PROVISIONING_PASSWORD=

# --- Limitação de tentativas de POST /api/auth/login ---
# Opcionais; os padrões abaixo já se aplicam sem declarar nada aqui.
#IWRITE_LOGIN_RATE_LIMIT_MAX_PER_ORIGIN=20
#IWRITE_LOGIN_RATE_LIMIT_MAX_PER_ACCOUNT=8
#IWRITE_LOGIN_RATE_LIMIT_MAX_TRACKED_KEYS=10000
#IWRITE_LOGIN_RATE_LIMIT_WINDOW=1m

# --- Logs estruturados correlacionados (docs/otel-correlated-logs.md) ---
# Exporta os key-value pairs do SLF4J 2 como atributos do log record, tornando
# os eventos de negócio pesquisáveis por campo no Loki. Já definida pelo
# override docker-compose.observability.yml; declare aqui apenas se estiver
# apontando para o backend institucional.
# Propriedade equivalente:
#   otel.instrumentation.logback-appender.experimental.capture-key-value-pair-attributes=true
#OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_KEY_VALUE_PAIR_ATTRIBUTES=true

# NÃO habilite estas duas: exportam MDC inteiro e todos os argumentos de log,
# ou seja, texto livre não revisado (conteúdo, IDs, parâmetros do cliente).
#OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_CAPTURE_MDC_ATTRIBUTES=*
#OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_LOG_ATTRIBUTES=true

# Nível dos eventos de negócio. INFO (default) emite um evento por operação
# concluída; WARN silencia os resultados de sucesso sem perder conflitos e
# falhas. Não use DEBUG em produção.
#LOGGING_LEVEL_COM_IWRITE_BUSINESS_EVENTS=INFO
