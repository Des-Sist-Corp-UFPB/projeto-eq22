# Exemplo de variáveis de ambiente. Não versione valores reais.

# Banco de dados
DB_URL=jdbc:postgresql://localhost:5435/iwrite
DB_USERNAME=postgres
DB_PASSWORD=postgres

# MCP (desabilitado por padrão; /sse e /mcp/message não são expostos)
IWRITE_MCP_ENABLED=false

# OpenTelemetry (opcional; padrão desabilitado, sem nenhuma variável extra)
IWRITE_OTEL_ENABLED=false

# Exige OTEL_EXPORTER_OTLP_HEADERS quando true (backend institucional).
# Com false, dispensa headers (ex.: LGTM local sem autenticação).
IWRITE_OTEL_AUTH_REQUIRED=false

# Obrigatórias apenas quando IWRITE_OTEL_ENABLED=true.
#OTEL_SERVICE_NAME=dsc-eq22

# --- Ambiente local (LGTM via docker-compose.observability.yml) ---
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318

# --- Servidor institucional (IWRITE_OTEL_AUTH_REQUIRED=true) ---
# O token/headers devem vir de secret ou variável de ambiente ignorada pelo Git.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.exemplo-institucional.invalid
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <TOKEN_AQUI>

# Defaults aplicados automaticamente quando OTel está habilitado e a variável
# não é definida (não é preciso declarar, listado aqui só como referência):
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#OTEL_TRACES_EXPORTER=otlp
#OTEL_METRICS_EXPORTER=otlp
#OTEL_LOGS_EXPORTER=otlp
