BACKEND_ORIGIN=http://localhost:8085
# NEXT_PUBLIC_API_URL: legada/depreciada, lida apenas se BACKEND_ORIGIN não estiver definida.
# NEXT_PUBLIC_API_URL=http://localhost:8085

# Analytics de produto (Umami) — opcional; desabilitado por padrão.
# Nunca versione o website ID real: obtenha-o no painel do Umami do projeto IWrite.
NEXT_PUBLIC_UMAMI_ENABLED=false
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=REPLACE_WITH_OFFICIAL_WEBSITE_ID
# Somente se o endpoint de coleta for diferente da origem do script:
# NEXT_PUBLIC_UMAMI_HOST_URL=
