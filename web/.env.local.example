NEXT_PUBLIC_UMAMI_ENABLED=false
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.dsc.rodrigor.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=REPLACE_WITH_OFFICIAL_WEBSITE_ID
